            "title": "Field"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "Id": {
        "pattern": "^[1-9][0-9]*$",
        "type": "string"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "maxLength": 256,
            "minLength": 1,
