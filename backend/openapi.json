        ],
        "title": "ApiError",
        "type": "object"
      },
      "Date": {
        "format": "date",
        "type": "string"
      },
      "DateTime": {
        "format": "date-time",
        "type": "string"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
