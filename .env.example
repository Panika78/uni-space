# Local development values only. Do not reuse them in production.
POSTGRES_DB=uni_space
POSTGRES_USER=uni_space
POSTGRES_PASSWORD=local-development-password
# Used by a backend running on the host; Compose overrides it with db:5432 for the API service.
DATABASE_URL=postgresql+psycopg://uni_space:local-development-password@localhost:5432/uni_space

# Local only; generate a private key for production: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SIGNING_KEY=development-only-0123456789-ABCDEFGHIJKLMNOPQRSTUVWXYZ
JWT_ISSUER=uni-space
JWT_AUDIENCE=uni-space-api
ACCESS_TTL_SECONDS=600
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
ALLOWED_ORIGINS='["http://localhost:5173"]'
