# Copy outside the repository. No secret VALUES belong in this file.
RELEASE_TAG=<git-commit-sha>
SERVER_NAME=<site-hostname>
ALLOWED_ORIGINS='["https://<site-hostname>"]'
POSTGRES_DB=uni_space
POSTGRES_USER=uni_space
JWT_SIGNING_KEY_FILE=/absolute/private/path/jwt_signing_key
POSTGRES_PASSWORD_FILE=/absolute/private/path/postgres_password
TLS_CERT_FILE=/absolute/private/path/fullchain.pem
TLS_KEY_FILE=/absolute/private/path/privkey.pem
# Choose a free RFC1918 subnet on the target host; trust only nginx's exact IP.
PROXY_SUBNET=172.30.19.0/24
PROXY_DYNAMIC_RANGE=172.30.19.128/25
NGINX_PROXY_IP=172.30.19.2
