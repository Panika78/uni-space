# Do not log request bodies, cookies, Authorization or query strings.
log_format safe '$remote_addr $request_method $uri $status';
access_log /var/log/nginx/access.log safe;
server_tokens off;

server {
    listen 80 default_server;
    server_name ${SERVER_NAME};
    return 308 https://${SERVER_NAME}$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name ${SERVER_NAME};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    root /usr/share/nginx/html;
    index index.html;

    # Includes /api itself. Unknown API URLs must keep their JSON 404.
    location ~ ^/api(?:/|$) {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host '';
        proxy_set_header X-Forwarded-Port '';
        proxy_set_header X-Forwarded-Prefix '';
        proxy_set_header Forwarded '';
        proxy_set_header Connection '';
        proxy_redirect off;
    }
    location /assets/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
# Container-local healthcheck only; proves proxy -> API, not just nginx -t.
server {
    listen 127.0.0.1:8080;
    location = /ready {
        proxy_pass http://api:8000/api/openapi.json;
        access_log off;
    }
}
