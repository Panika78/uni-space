# Do not log request bodies, cookies, Authorization or query strings.
log_format safe '$remote_addr $request_method $uri $status';
server_tokens off;
# String keys in map are case-insensitive. HTTPS requires the canonical authority;
# HTTP may arrive on another port, but must still name the same hostname.
map $http_host $trusted_https_host {
    default 0;
    "${PUBLIC_AUTHORITY}" 1;
}
map $host $trusted_http_host {
    default 0;
    "${PUBLIC_HOSTNAME}" 1;
}

server {
    listen 80 default_server;
    server_name ${PUBLIC_HOSTNAME};
    # Override the stock http-level main log; do not add a second global log.
    access_log /var/log/nginx/access.log safe;
    if ($trusted_http_host = 0) { return 421; }
    return 308 https://${PUBLIC_AUTHORITY}$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name ${PUBLIC_HOSTNAME};
    # Override the stock http-level main log; do not add a second global log.
    access_log /var/log/nginx/access.log safe;
    if ($trusted_https_host = 0) { return 421; }
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    root /usr/share/nginx/html;
    index index.html;

    # Includes /api itself. Unknown API URLs must keep their JSON 404.
    location ~ ^/api(?:/|$) {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host "${PUBLIC_AUTHORITY}";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host '';
        proxy_set_header X-Forwarded-Port '';
        proxy_set_header X-Forwarded-Prefix '';
        proxy_set_header Forwarded '';
        proxy_set_header Connection '';
        proxy_redirect off;
    }
    location /assets/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
# Container-local healthcheck only; proves proxy -> API, not just nginx -t.
server {
    listen 127.0.0.1:8080;
    access_log off;
    location = /ready {
        proxy_pass http://api:8000/api/openapi.json;
        proxy_set_header Host "${PUBLIC_AUTHORITY}";
    }
}
